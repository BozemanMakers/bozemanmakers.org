---
import { org } from '../data/org';

const { standard, college, household } = org.membership;

const tiers = [
  { ...standard, note: undefined, primary: true },
  { ...college, note: undefined, primary: false },
  { ...household, primary: false },
];
---

<!-- Every plan has the same perks, so they are listed once. -->
<ul class="perks">
  {org.membership.perks.map((perk) => <li>{perk}</li>)}
</ul>

<ul class="tier-list">
  {
    tiers.map((tier) => (
      <li>
        <a
          class:list={['tier-row', tier.primary && 'tier-row--pick']}
          href={`${org.memberful.checkout}${tier.planId}`}
          target="_blank"
          rel="noopener"
        >
          <span class="tier-row__name">{tier.name}</span>
          <span class="tier-row__price">{tier.price}</span>
          <span class="tier-row__arrow" aria-hidden="true">
            ↗
          </span>
          {tier.note && <span class="tier-row__note">{tier.note}</span>}
        </a>
      </li>
    ))
  }
</ul>
