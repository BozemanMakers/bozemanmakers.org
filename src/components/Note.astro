---
interface Props {
  tone?: 'info' | 'stop';
  title?: string;
  /** Monochrome emoji; the page must import the Noto Emoji font. */
  icon?: string;
}

const { tone, title, icon } = Astro.props;
---

<aside class:list={['bzm-note', tone && `bzm-note--${tone}`]}>
  <div class="bzm-note__stripe"></div>
  <div class:list={['bzm-note__body', icon && 'bzm-note__body--icon']}>
    {icon && <span class="bzm-note__icon" aria-hidden="true">{icon}</span>}
    <div>
      {title && <strong>{title}</strong>}
      <slot />
    </div>
  </div>
</aside>
