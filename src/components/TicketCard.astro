---
interface Props {
  href: string;
  title: string;
  icon: string;
  id?: string;
  anchors?: readonly string[];
  external?: boolean;
}

const { href, title, icon, id, anchors = [], external = true } = Astro.props;
---

<article class="bzm-card tool-card" id={id}>
  {anchors.map((anchor) => <span id={anchor} aria-hidden="true"></span>)}
  <a
    class="tool-card__link"
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener' : undefined}
  >
    <span class="tool-card__icon" aria-hidden="true">{icon}</span>
    <h3 class="bzm-card__title">{title}</h3>
    {external && <span aria-hidden="true">↗</span>}
  </a>
</article>
