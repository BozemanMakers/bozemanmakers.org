---
import TierTable from './TierTable.astro';
import { org } from '../data/org';
import { microcopy } from '../content/microcopy';
---

<!-- Plans come first so they are visible without scrolling after a QR scan. -->
<div class="membership-panel" id="sign-up">
  <TierTable />

  <!-- source: archive/home.md:L33-L34 -->
  <p class="membership-rule">
    Members must be 18+ with a signed
    <a href={org.releaseForm} target="_blank" rel="noopener">
      Release Form<span class="visually-hidden"> (PDF, {microcopy.aria.opensNewTab})</span></a>.
  </p>

  <!-- source: archive/home.md:L30-L37, condensed -->
  <div class="prose">
    <p>
      <strong>Want a tour first?</strong> Drop by a
      Thursday evening Open Build. We'll answer questions, and it's where we do
      new member walkthroughs and key fob sign-out. If you sign up, please plan
      on attending the next one.
    </p>
    <!-- owner edits 2026-11-24: printer copies, parent/guardian -->
    <p>
      No printer? We have copies of the release form at the space. Kids are
      welcome with their parent or guardian.
    </p>
  </div>

  <!-- source: archive/home.md:L71-L75 -->
  <p><a href={org.memberful.portal}>Manage My Membership</a></p>
  <p>
    <em>Having trouble? <a href="/contact/">Contact an officer</a> for assistance.</em>
  </p>
</div>
