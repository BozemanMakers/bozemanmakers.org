---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { heroPhotoAlt } from '../data/heroPhotos';
import { microcopy } from '../content/microcopy';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, mod]) => {
    const name = path.split('/').pop() ?? path;
    return {
      name,
      src: mod.default,
      alt: heroPhotoAlt[name] ?? 'The Bozeman Makerspace shop floor.',
    };
  });

const multiple = photos.length > 1;
const total = photos.length;
---

<div
  class="hero-carousel"
  role="group"
  aria-roledescription="carousel"
  aria-label={microcopy.aria.carousel}
>
  <div class="hero-carousel__frame">
    <div
      class="hero-carousel__track"
      data-hero-track
      tabindex={multiple ? 0 : undefined}
      aria-label={multiple ? microcopy.aria.carousel : undefined}
    >
      {
        photos.map((photo, index) => (
          <div
            class="hero-carousel__slide"
            data-hero-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} / ${total}`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 56.25em) 48vw, 100vw"
              quality={60}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
          </div>
        ))
      }
    </div>
  </div>

  {
    multiple && (
      <div class="hero-carousel__bar">
        <div class="hero-carousel__dots">
          {photos.map((_, index) => (
            <button
              type="button"
              class="hero-carousel__dot"
              data-hero-dot
              aria-label={`${microcopy.aria.showPhoto} ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
            />
          ))}
        </div>
        <p class="hero-carousel__count" aria-hidden="true" data-hero-count>
          1 / {total}
        </p>
        <p class="visually-hidden" aria-live="polite" data-hero-status></p>
        <div class="hero-carousel__nav">
          <button
            type="button"
            class="hero-carousel__btn"
            data-hero-prev
            aria-label={microcopy.aria.prevPhoto}
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="hero-carousel__btn"
            data-hero-next
            aria-label={microcopy.aria.nextPhoto}
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  for (const root of document.querySelectorAll<HTMLElement>(
    '.hero-carousel'
  )) {
    const track = root.querySelector<HTMLElement>('[data-hero-track]');
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('[data-hero-slide]')
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')
    );
    const prev = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-hero-next]');
    const count = root.querySelector<HTMLElement>('[data-hero-count]');
    const status = root.querySelector<HTMLElement>('[data-hero-status]');

    if (!track || slides.length < 2) continue;

    let index = 0;
    let frame = 0;

    const render = () => {
      for (const [i, dot] of dots.entries()) {
        if (i === index) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      }
      if (count) count.textContent = `${index + 1} / ${slides.length}`;
      if (status) status.textContent = `Photo ${index + 1} of ${slides.length}`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    const go = (target: number, smooth = true) => {
      index = Math.max(0, Math.min(slides.length - 1, target));
      track.scrollTo({
        left: index * track.clientWidth,
        behavior: smooth && !prefersReducedMotion ? 'smooth' : 'auto',
      });
      render();
    };

    const sync = () => {
      frame = 0;
      if (!track.clientWidth) return;
      const nearest = Math.round(track.scrollLeft / track.clientWidth);
      if (nearest !== index) {
        index = nearest;
        render();
      }
    };

    track.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(sync);
      },
      { passive: true }
    );

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        go(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        go(slides.length - 1);
      }
    });

    window.addEventListener('resize', () => go(index, false));
    render();
  }
</script>
