---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';
import TicketCard from '../components/TicketCard.astro';
import WikiLink from '../components/WikiLink.astro';

import { org } from '../data/org';
import { wiki } from '../data/wiki';
import { microcopy } from '../content/microcopy';

const meta = microcopy.meta.tools;
---

<Base title={meta.title} description={meta.description}>
  <div class="page-intro">
    <h1>Tools</h1>
  </div>

  <section class="section" id="tools-at-the-makerspace" aria-labelledby="tools-heading">
    <h2 id="tools-heading">Tools at the Makerspace</h2>
    <div class="prose">
      <!-- source: archive/tools.md:L16-L20 -->
      <!-- TODO(copy): "this list" is a placeholder unless approved as-is (docs/08-mvp-build-plan.md §3). -->
      <p>
        The Makerspace has <em>many</em> tools, all of which are usable by
        members. We do our best to keep this list up to date, but we're adding
        new tools all the time, so stop by for a tour for the most up-to-date
        list!
      </p>
      <p>
        <strong>
          Want the specifics on a tool? Check out our new
          <WikiLink href={wiki.toolsShelf}>wiki</WikiLink> for more details!
        </strong>
      </p>
    </div>
  </section>

  <section class="section" aria-label="Tools">
    <div class="card-grid">
      <TicketCard
        href={wiki.books.woodworking}
        title="Woodworking"
        id="woodworking"
        anchors={['big-tools', 'powered-hand-tools', 'manual-hand-tools']}
        tone="wood"
      />
      <TicketCard
        href={wiki.books.electronics}
        title="Electronics"
        id="electronics"
        tone="electronics"
      />
      <TicketCard
        href={wiki.books.metalworking}
        title="Metalworking"
        id="metals"
        anchors={['metalworking', 'machining']}
        tone="metal"
      />
      <TicketCard
        href={wiki.books.textiles}
        title="Textiles"
        id="crafts-textiles"
        anchors={['sewing', 'vinyl-cutting-accessories', 'miscellaneous']}
      />
      <TicketCard href={wiki.books.jewelry} title="Jewelry" id="jewelry" />
      <TicketCard
        href={wiki.books.printing3d}
        title="3D Printing"
        id="3d-printers"
        anchors={['other-cnc-computer-controlled-machines']}
        tone="electronics"
      />
      <TicketCard
        href={wiki.books.laserCutting}
        title="Laser Cutting"
        id="laser-cutter"
        tone="electronics"
      />
      <!-- TODO(copy): card title vs wiki book name ("Painting") — confirm the label. -->
      <TicketCard href={wiki.books.painting} title="Painting" id="painting-coating" />
      <TicketCard href={wiki.books.pottery} title="Pottery" id="pottery" />
    </div>

    <div class="tools-note">
      <!-- source: wiki:faq -->
      <Note tone="info">
        <p>
          Restricted tools, also called "red tools," are marked with a red sign
          or sticker. A training session is required before using any of these
          tools, regardless of experience. Most trainings take less than 30
          minutes.
        </p>
      </Note>
    </div>
  </section>

  <section class="section" id="tool-wishlist" aria-labelledby="wishlist-heading">
    <!-- source: archive/tools.md:L169-L181 -->
    <h2 id="wishlist-heading">Tool Wishlist</h2>
    <div class="prose">
      <p>
        We decided to add an on-going tool wishlist here. If you have a tool you
        would like to donate to the space, drop us a line at
        <a href={`mailto:${org.email}`}>{org.email}</a>. New or used tools are
        accepted. Slightly broken tools may also be accepted, however we do not
        want something that is absolutely broken and is headed to the trash bin.
      </p>
      <ul>
        <li>More capable digital oscilloscope</li>
        <li>Clamps (can you have too many?)</li>
        <li>3D Printer filament</li>
        <li>Router bits</li>
        <li>Unused (or lightly used) Arduino or Raspberry Pi boards</li>
        <li>Cordless drills or impact wrenches</li>
        <li>Common fasteners (wood and sheet metal screws, etc)</li>
      </ul>
    </div>
  </section>
</Base>
