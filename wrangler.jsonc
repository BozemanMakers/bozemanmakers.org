{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bozemanmakers-org",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
